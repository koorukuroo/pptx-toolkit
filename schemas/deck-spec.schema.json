{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.today/schemas/pptx-toolkit/deck-spec.schema.json",
  "title": "pptx-toolkit deck specification v0.4",
  "type": "object",
  "required": [
    "metadata",
    "route",
    "slides"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "audience",
        "success_condition",
        "delivery_mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "subtitle": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "presenter": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "success_condition": {
          "type": "string"
        },
        "delivery_mode": {
          "enum": [
            "live",
            "pre_read",
            "hybrid"
          ]
        },
        "duration_minutes": {
          "type": "number",
          "minimum": 1
        },
        "target_slide_count": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string"
        },
        "confidentiality": {
          "type": "string"
        },
        "sticker": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "description": "공고번호·문서번호 (표지 머리줄에 기관명과 함께)"
        },
        "audience_state": {
          "type": "object",
          "properties": {
            "initial": {
              "type": "string"
            },
            "desired": {
              "type": "string"
            }
          },
          "description": "청중의 시작 상태와 자료를 본 뒤의 목표 상태 (서사 설계)"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "deck_type",
        "style_profile",
        "brand_mode"
      ],
      "properties": {
        "deck_type": {
          "enum": [
            "government_briefing",
            "public_policy_report",
            "consulting_executive",
            "proposal_bid",
            "product_intro",
            "training_lecture",
            "keynote_story",
            "template_fill",
            "redesign_existing"
          ]
        },
        "style_profile": {
          "type": "string"
        },
        "brand_mode": {
          "enum": [
            "provided",
            "derived",
            "neutral"
          ]
        },
        "communication_mode": {
          "enum": [
            "pyramid",
            "briefing",
            "narrative",
            "instructional",
            "showcase"
          ]
        }
      },
      "additionalProperties": false
    },
    "design_tokens": {
      "type": "object"
    },
    "assets": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string"
        },
        "images": {
          "type": "object"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "kind",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "estimate",
              "interpretation",
              "recommendation",
              "user_provided"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "number",
          "archetype",
          "title"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string"
          },
          "archetype": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 140
          },
          "takeaway": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_note": {
            "type": "string"
          },
          "speaker_notes": {
            "type": "string"
          },
          "sticker": {
            "type": "string"
          },
          "exhibit": {
            "type": [
              "string",
              "integer"
            ]
          },
          "variant": {
            "type": "string"
          },
          "background": {
            "enum": [
              "light",
              "dark",
              "surface"
            ]
          },
          "appendix": {
            "type": "boolean"
          },
          "qa": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "enum": [
              "hook",
              "context",
              "tension",
              "method",
              "proof",
              "takeaway"
            ],
            "description": "서사 역할 — lint role-coverage 가 hook/proof/takeaway 커버리지를 검사"
          },
          "brief": {
            "description": "제목 아래 요구사항·대응방안 블록 (제안서형 프레임). {requirement, response} 또는 [{label, text, emphasis}]",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "requirement": {
                    "type": "string"
                  },
                  "response": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "emphasis": {
                      "type": "boolean"
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            ]
          },
          "verification": {
            "description": "본문 아래 검증 기준·산출물 블록. {criteria, deliverables} 또는 [{label, text, muted}]",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "criteria": {
                    "type": "string"
                  },
                  "deliverables": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "emphasis": {
                      "type": "boolean"
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            ]
          },
          "tags": {
            "description": "푸터 태그 줄: 관련 요구 ID. [\"SFR-003\"] 또는 {label:\"RFP\", ids:[…]}",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ids"
                ]
              }
            ]
          },
          "xref": {
            "type": "string",
            "description": "푸터 오른쪽 참조 (예: '기능 조견표 · 66쪽')"
          },
          "summary": {
            "description": "본문 아래 요약 한 줄. {label, text, style: line|band} 또는 문자열",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "style": {
                    "enum": [
                      "line",
                      "band"
                    ]
                  }
                }
              }
            ]
          },
          "footer_left": {
            "type": "string",
            "description": "이 슬라이드의 왼쪽 푸터 글자 (기본은 문서 제목·기관)"
          }
        }
      }
    }
  }
}
